{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Limn",
  "version": "0.1.4",
  "identifier": "org.borck.limn",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Limn",
        "width": 1100,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "GraphicsAndDesign",
    "shortDescription": "Privacy-first text-to-image — bring your own provider",
    "longDescription": "Type a description, get an image. No account, no telemetry; images are generated by the provider you configure (self-hosted SwarmUI, any OpenAI-compatible endpoint, OpenAI, or Google Imagen) and saved locally.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0N0YxRDhBN0U1MTlCMDMKUldRRG0xRitpaDEvRkF1SWNRZjBMNXZUUUlKMUpsemova0J1VnNNb3RDSVJFa1U5N2lDN2ZPM08K",
      "endpoints": [
        "https://github.com/michael-borck/limn/releases/latest/download/latest.json"
      ]
    }
  }
}
